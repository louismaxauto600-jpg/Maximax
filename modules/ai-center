<style>

:root{
  --black:#000000;
  --orange:#FF6A00;
  --orange-light:#FFA347;
  --orange-deep:#B34700;
  --text:#FFC98A;
  --line:rgba(255,163,71,.34);
  --panel:rgba(0,0,0,.68);
  --panel2:rgba(255,106,0,.08);
}

*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  min-height:100vh;
  font-family:'Public Sans',sans-serif;
  color:var(--text);

  background:
    radial-gradient(
      circle at 20% 15%,
      rgba(255,106,0,.25),
      transparent 35%
    ),
    radial-gradient(
      circle at 85% 45%,
      rgba(179,71,0,.30),
      transparent 40%
    ),
    linear-gradient(
      145deg,
      #000 0%,
      #000 18%,
      #421800 45%,
      #FF6A00 72%,
      #000 100%
    );

  background-attachment:fixed;
}

a{
  color:inherit;
  text-decoration:none;
}

button,
input,
textarea,
select{
  font:inherit;
}

h1,
h2,
h3{
  font-family:'Fraunces',serif;
  margin:0;
}

/* =====================================================
   HEADER
===================================================== */

header{
  position:sticky;
  top:0;
  z-index:100;

  background:rgba(0,0,0,.84);

  backdrop-filter:blur(12px);

  border-bottom:1px solid var(--line);
}

.header-inner{
  max-width:1200px;
  margin:0 auto;

  padding:12px 22px;

  display:flex;
  align-items:center;
  justify-content:space-between;

  gap:18px;
}

.brand{
  display:flex;
  align-items:center;

  gap:12px;
}

.logo{
  width:48px;
  height:48px;

  border-radius:50%;

  position:relative;

  overflow:hidden;

  border:2px solid var(--orange-light);

  background:#000;

  display:flex;
  align-items:center;
  justify-content:center;

  flex-shrink:0;
}

.logo video{
  position:absolute;

  inset:0;

  width:100%;
  height:100%;

  object-fit:cover;

  display:none;

  z-index:2;
}

.logo video.loaded{
  display:block;
}

.logo-fallback{
  position:relative;

  z-index:1;

  color:var(--orange-light);

  font-family:'Fraunces',serif;

  font-weight:700;

  font-size:18px;
}

.brand-text strong{
  display:block;

  font-family:'Fraunces',serif;

  font-size:17px;

  color:var(--orange-light);
}

.brand-text span{
  display:block;

  margin-top:2px;

  font-family:'IBM Plex Mono',monospace;

  font-size:9px;

  letter-spacing:.15em;
}

.header-actions{
  display:flex;

  align-items:center;

  gap:10px;

  flex-wrap:wrap;

  justify-content:flex-end;
}

.back-btn{
  padding:9px 14px;

  border:1px solid var(--line);

  border-radius:22px;

  font-family:'IBM Plex Mono',monospace;

  font-size:10px;

  letter-spacing:.08em;

  transition:.2s;

  background:rgba(0,0,0,.5);
}

.back-btn:hover{
  border-color:var(--orange-light);

  color:var(--orange-light);
}

/* =====================================================
   LANGUAGE
===================================================== */

.lang-toggle{
  display:flex;

  gap:3px;

  border:1px solid var(--line);

  border-radius:22px;

  padding:3px;

  background:rgba(0,0,0,.45);
}

.lang-btn{
  border:none;

  background:none;

  color:var(--text);

  padding:7px 11px;

  border-radius:18px;

  font-family:'IBM Plex Mono',monospace;

  font-size:10px;

  cursor:pointer;

  opacity:.65;
}

.lang-btn.active{
  background:var(--orange);

  color:#140900;

  font-weight:700;

  opacity:1;
}

/* =====================================================
   HERO
===================================================== */

.hero{
  max-width:1200px;

  margin:0 auto;

  padding:72px 22px 48px;

  display:grid;

  grid-template-columns:1.2fr .8fr;

  gap:40px;

  align-items:center;
}

.eyebrow{
  font-family:'IBM Plex Mono',monospace;

  color:var(--orange-light);

  font-size:11px;

  letter-spacing:.18em;

  text-transform:uppercase;

  margin-bottom:15px;
}

.hero h1{
  font-size:clamp(2.5rem,6vw,4.8rem);

  line-height:.98;

  font-weight:600;
}

.hero h1 span{
  color:var(--orange-light);
}

.hero p{
  max-width:650px;

  margin:20px 0 0;

  line-height:1.7;

  font-size:16px;

  opacity:.88;
}

.hero-buttons{
  margin-top:28px;

  display:flex;

  gap:12px;

  flex-wrap:wrap;
}

.btn{
  display:inline-flex;

  align-items:center;

  justify-content:center;

  min-height:45px;

  padding:11px 20px;

  border-radius:5px;

  border:1px solid transparent;

  font-family:'IBM Plex Mono',monospace;

  font-size:11px;

  text-transform:uppercase;

  letter-spacing:.08em;

  cursor:pointer;

  transition:.2s;
}

.btn-primary{
  background:var(--orange);

  color:#180A00;
}

.btn-primary:hover{
  background:var(--orange-light);
}

.btn-secondary{
  border-color:var(--line);

  background:rgba(0,0,0,.45);
}

.btn-secondary:hover{
  border-color:var(--orange-light);

  color:var(--orange-light);
}

.hero-orb{
  width:280px;
  height:280px;

  justify-self:end;

  position:relative;

  border-radius:50%;

  background:
    radial-gradient(
      circle at center,
      rgba(255,106,0,.30),
      #000 68%
    );

  border:1px solid var(--orange-light);

  display:flex;

  align-items:center;

  justify-content:center;

  box-shadow:
    0 0 70px rgba(255,106,0,.18),
    inset 0 0 50px rgba(255,106,0,.12);
}

.hero-orb::before{
  content:"";

  position:absolute;

  inset:17px;

  border-radius:50%;

  border:1px dashed rgba(255,163,71,.55);

  animation:spin 16s linear infinite;
}

.hero-orb::after{
  content:"AI";

  font-family:'Fraunces',serif;

  font-size:78px;

  color:var(--orange-light);

  font-weight:700;

  text-shadow:0 0 28px rgba(255,106,0,.4);
}

@keyframes spin{
  from{
    transform:rotate(0);
  }

  to{
    transform:rotate(360deg);
  }
}

@media(max-width:850px){

  .hero{
    grid-template-columns:1fr;
  }

  .hero-orb{
    justify-self:center;

    width:220px;

    height:220px;
  }

}

/* =====================================================
   MAIN
===================================================== */

main{
  max-width:1200px;

  margin:0 auto;

  padding:25px 22px 80px;
}

.section-heading{
  margin-bottom:25px;
}

.section-heading .tag{
  font-family:'IBM Plex Mono',monospace;

  font-size:10px;

  color:var(--orange-light);

  letter-spacing:.15em;

  text-transform:uppercase;
}

.section-heading h2{
  margin-top:7px;

  font-size:2rem;
}

/* =====================================================
   AI MODULE CARDS
===================================================== */

.ai-grid{
  display:grid;

  grid-template-columns:repeat(
    auto-fit,
    minmax(250px,1fr)
  );

  gap:18px;
}

.ai-card{
  position:relative;

  border:1px solid var(--line);

  background:
    linear-gradient(
      145deg,
      rgba(0,0,0,.82),
      rgba(40,14,0,.72)
    );

  border-radius:10px;

  padding:22px;

  min-height:225px;

  display:flex;

  flex-direction:column;

  transition:
    transform .2s,
    border-color .2s,
    box-shadow .2s;
}

.ai-card:hover{
  transform:translateY(-4px);

  border-color:var(--orange-light);

  box-shadow:0 15px 35px rgba(0,0,0,.35);
}

.ai-number{
  width:34px;

  height:34px;

  border-radius:50%;

  border:1px solid var(--orange-light);

  display:flex;

  align-items:center;

  justify-content:center;

  color:var(--orange-light);

  font-family:'IBM Plex Mono',monospace;

  font-size:10px;

  margin-bottom:18px;
}

.ai-card h3{
  color:var(--orange-light);

  font-family:'Public Sans',sans-serif;

  font-size:17px;

  margin-bottom:10px;
}

.ai-card p{
  margin:0 0 20px;

  font-size:13px;

  line-height:1.6;

  opacity:.82;

  flex:1;
}

.open-tool{
  width:100%;

  border:1px solid var(--line);

  background:rgba(255,106,0,.08);

  color:var(--orange-light);

  border-radius:5px;

  padding:10px;

  cursor:pointer;

  font-family:'IBM Plex Mono',monospace;

  font-size:10px;

  letter-spacing:.08em;

  text-transform:uppercase;

  transition:.2s;
}

.open-tool:hover{
  background:var(--orange);

  color:#000;

  border-color:var(--orange);
}

/* =====================================================
   TOOL PANEL
===================================================== */

.tool-panel{
  margin-top:35px;

  border:1px solid var(--line);

  border-radius:10px;

  padding:25px;

  background:rgba(0,0,0,.75);

  display:none;
}

.tool-panel.active{
  display:block;
}

.tool-header{
  display:flex;

  justify-content:space-between;

  align-items:center;

  gap:15px;

  margin-bottom:20px;
}

.tool-header h2{
  font-size:1.7rem;

  color:var(--orange-light);
}

.close-tool{
  border:1px solid var(--line);

  background:#000;

  color:var(--orange-light);

  width:38px;

  height:38px;

  border-radius:50%;

  cursor:pointer;
}

.form-grid{
  display:grid;

  grid-template-columns:1fr 1fr;

  gap:15px;
}

.field{
  display:flex;

  flex-direction:column;

  gap:7px;
}

.field.full{
  grid-column:1/-1;
}

.field label{
  font-family:'IBM Plex Mono',monospace;

  color:var(--orange-light);

  font-size:10px;

  letter-spacing:.08em;

  text-transform:uppercase;
}

.field input,
.field textarea,
.field select{
  width:100%;

  background:#000;

  color:var(--text);

  border:1px solid var(--line);

  border-radius:5px;

  padding:12px;

  outline:none;
}

.field textarea{
  min-height:150px;

  resize:vertical;
}

.field input:focus,
.field textarea:focus,
.field select:focus{
  border-color:var(--orange-light);
}

.generate-row{
  margin-top:18px;

  display:flex;

  gap:12px;

  flex-wrap:wrap;
}

.output{
  margin-top:22px;

  min-height:150px;

  padding:18px;

  border:1px dashed var(--line);

  background:rgba(255,106,0,.04);

  border-radius:6px;

  white-space:pre-wrap;

  line-height:1.6;

  font-size:14px;
}

@media(max-width:650px){

  .form-grid{
    grid-template-columns:1fr;
  }

}

/* =====================================================
   DISCLAIMER
===================================================== */

.notice{
  margin-top:35px;

  padding:18px;

  border-left:4px solid var(--orange);

  background:rgba(0,0,0,.6);

  font-size:12px;

  line-height:1.6;

  opacity:.85;
}

/* =====================================================
   FOOTER
===================================================== */

footer{
  border-top:1px solid var(--line);

  background:rgba(0,0,0,.76);

  padding:30px 22px;
}

.footer-inner{
  max-width:1200px;

  margin:0 auto;

  display:flex;

  align-items:center;

  justify-content:space-between;

  gap:15px;

  flex-wrap:wrap;

  font-family:'IBM Plex Mono',monospace;

  font-size:10px;

  opacity:.72;
}

@media(max-width:700px){

  .header-inner{
    align-items:flex-start;
  }

  .brand-text span{
    font-size:8px;
  }

  .header-actions{
    gap:5px;
  }

  .back-btn{
    padding:8px 10px;

    font-size:8px;
  }

  .lang-btn{
    padding:6px 8px;
  }

}

@media(prefers-reduced-motion:reduce){

  *{
    animation:none!important;
    transition:none!important;
  }

}

