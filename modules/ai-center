kr:"Òganize rechèch, resous, sijè ak enfòmasyon dosye."

}

},

{

id:"multilingual",

number:"07",

title:{

en:"AI Multilingual Assistant",

fr:"Assistant multilingue IA",

kr:"AI Asistan Miltileng"

},

description:{

en:"Work across English, French, and Haitian Creole from one assistant.",

fr:"Travaillez en anglais, français et créole haïtien avec un seul assistant.",

kr:"Travay an Anglè, Fransè ak Kreyòl Ayisyen ak yon sèl asistan."

}

}

];

/* =====================================================
   GLOBAL STATE
===================================================== */

let currentLang="en";

let activeTool=null;

/* =====================================================
   RENDER TOOLS
===================================================== */

function renderTools(){

const grid=
document.getElementById("aiGrid");

grid.innerHTML=

TOOLS.map(tool=>`

<div class="ai-card">

<div class="ai-number">
${tool.number}
</div>

<h3>
${tool.title[currentLang]}
</h3>

<p>
${tool.description[currentLang]}
</p>

<button
class="open-tool"
data-tool="${tool.id}">

${currentLang==="en"
?"OPEN TOOL"
:currentLang==="fr"
?"OUVRIR L'OUTIL"
:"OUVRI ZOUTI"}

</button>

</div>

`).join("");

}

/* =====================================================
   APPLY LANGUAGE
===================================================== */

function applyLanguage(){

const t=
UI[currentLang];

document.getElementById("htmlRoot").lang=
currentLang;

document.getElementById("heroTag").textContent=
t.heroTag;

document.getElementById("heroTitle").innerHTML=
t.heroTitle;

document.getElementById("heroDesc").textContent=
t.heroDesc;

document.getElementById("exploreBtn").textContent=
t.explore;

document.getElementById("homeBtn").textContent=
t.home;

document.getElementById("backHome").textContent=
t.back;

document.getElementById("toolTag").textContent=
t.toolTag;

document.getElementById("toolTitle").textContent=
t.toolTitle;

document.getElementById("inputLabel").textContent=
t.inputLabel;

document.getElementById("languageLabel").textContent=
t.languageLabel;

document.getElementById("toneLabel").textContent=
t.toneLabel;

document.getElementById("generateBtn").textContent=
t.generate;

document.getElementById("clearBtn").textContent=
t.clear;

document.getElementById("copyBtn").textContent=
t.copy;

document.getElementById("userInput").placeholder=
t.placeholder;

document.getElementById("notice").textContent=
t.notice;

if(!activeTool){

document.getElementById("outputBox").textContent=
t.ready;

}

document
.querySelectorAll(".lang-btn")
.forEach(btn=>{

btn.classList.toggle(
"active",
btn.dataset.lang===currentLang
);

});

renderTools();

if(activeTool){

const tool=
TOOLS.find(
item=>item.id===activeTool
);

if(tool){

document.getElementById("activeToolTitle").textContent=
tool.title[currentLang];

}

}

}

/* =====================================================
   OPEN TOOL
===================================================== */

document.addEventListener(
"click",
function(e){

const button=
e.target.closest(".open-tool");

if(!button)return;

activeTool=
button.dataset.tool;

const tool=
TOOLS.find(
item=>item.id===activeTool
);

if(!tool)return;

document.getElementById("activeToolTitle").textContent=
tool.title[currentLang];

const panel=
document.getElementById("toolPanel");

panel.classList.add("active");

panel.scrollIntoView({
behavior:"smooth",
block:"start"
});

}
);

/* =====================================================
   CLOSE TOOL
===================================================== */

document
.getElementById("closeTool")
.addEventListener(
"click",
function(){

document
.getElementById("toolPanel")
.classList.remove("active");

activeTool=null;

}
);

/* =====================================================
   LANGUAGE SWITCHER
===================================================== */

document
.getElementById("langToggle")
.addEventListener(
"click",
function(e){

const button=
e.target.closest(".lang-btn");

if(!button)return;

currentLang=
button.dataset.lang;

applyLanguage();

}
);

/* =====================================================
   GENERATE DEMO RESULT
===================================================== */

document
.getElementById("generateBtn")
.addEventListener(
"click",
function(){

const input=
document
.getElementById("userInput")
.value
.trim();

const output=
document.getElementById("outputBox");

if(!activeTool){

output.textContent=

currentLang==="fr"
?"Veuillez d'abord sélectionner un outil IA."
:currentLang==="kr"
?"Tanpri chwazi yon zouti AI anvan."
:"Please select an AI tool first.";

return;

}

if(!input){

output.textContent=

currentLang==="fr"
?"Veuillez entrer vos informations."
:currentLang==="kr"
?"Tanpri antre enfòmasyon ou."
:"Please enter your information.";

return;

}

const tool=
TOOLS.find(
item=>item.id===activeTool
);

const language=
document
.getElementById("outputLanguage")
.value;

const tone=
document
.getElementById("toneSelect")
.value;

/*
 IMPORTANT:
 This section is ready for a future AI API connection.

 At this stage the interface works locally and prepares
 the user's request. Later we can connect this button
 to your AI backend/API securely.
*/

output.textContent=

`AI CENTER

Tool:
${tool.title[currentLang]}

Requested language:
${language}

Style:
${tone}

Information received:
${input}

--------------------------------

Your AI API connection will generate the final response here.`;

}
);

/* =====================================================
   CLEAR
===================================================== */

document
.getElementById("clearBtn")
.addEventListener(
"click",
function(){

document.getElementById("userInput").value="";

document.getElementById("outputBox").textContent=
UI[currentLang].ready;

}
);

/* =====================================================
   COPY
===================================================== */

document
.getElementById("copyBtn")
.addEventListener(
"click",
async function(){

const text=
document.getElementById("outputBox").textContent;

try{

await navigator.clipboard.writeText(text);

this.textContent=

currentLang==="fr"
?"COPIÉ"
:currentLang==="kr"
?"KOPYE"
:"COPIED";

const button=this;

setTimeout(
()=>{

button.textContent=
UI[currentLang].copy;

},
1500
);

}

catch(error){

console.error(
"Copy failed:",
error
);

}

}
);

/* =====================================================
   LOGO VIDEO
===================================================== */

document
.querySelectorAll(
'video[src="../../maximax-best-multi.mp4"]'
)
.forEach(video=>{

const showVideo=()=>{

video.classList.add("loaded");

};

const hideVideo=()=>{

video.classList.remove("loaded");

};

video.addEventListener(
"loadeddata",
showVideo
);

video.addEventListener(
"canplay",
showVideo
);

video.addEventListener(
"error",
hideVideo
);

if(video.readyState>=2){

showVideo();

}

});

/* =====================================================
   START
===================================================== */

applyLanguage();

</script>

</body>
</html>
